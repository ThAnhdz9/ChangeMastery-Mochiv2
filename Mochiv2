task.spawn(function()
    local Players = game:GetService("Players")
    local localPlayer = Players.LocalPlayer
    local playerGui = localPlayer:WaitForChild("PlayerGui", 30)

    local MASTERY_REQUIRED = 300

    task.wait(10)

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "MasteryChecker"
    screenGui.ResetOnSpawn = false
    screenGui.DisplayOrder = 99999999999999999999999999999999999999999999999999999999999999999
    screenGui.AlwaysOnTop = true
    screenGui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 220, 0, 80)
    frame.Position = UDim2.new(0.5, -110, 0, 10)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

    local masteryLabel = Instance.new("TextLabel")
    masteryLabel.Size = UDim2.new(1, 0, 0.5, 0)
    masteryLabel.Position = UDim2.new(0, 0, 0, 0)
    masteryLabel.BackgroundTransparency = 1
    masteryLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    masteryLabel.TextScaled = true
    masteryLabel.Font = Enum.Font.GothamBold
    masteryLabel.Text = "Dough Mastery: ..."
    masteryLabel.Parent = frame

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, 0, 0.5, 0)
    statusLabel.Position = UDim2.new(0, 0, 0.5, 0)
    statusLabel.BackgroundTransparency = 1
    statusLabel.TextScaled = true
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.Text = "Đang kiểm tra..."
    statusLabel.Parent = frame

    local lastDoughMastery = nil

    local function getDoughMastery()
        local main = playerGui:FindFirstChild("Main")
        if not main then return lastDoughMastery end
        local skills = main:FindFirstChild("Skills")
        if not skills then return lastDoughMastery end
        local title = skills:FindFirstChild("Title")
        local level = skills:FindFirstChild("Level")
        if not title or not level then return lastDoughMastery end

        local titleText = title.Text:upper()
        if titleText == "DOUGH" or titleText == "MOCHI" then
            local num = level.Text:match("(%d+)")
            if num then
                lastDoughMastery = tonumber(num)
            end
        end
        return lastDoughMastery
    end

    local done = false

    repeat
        local ok, err = pcall(function()
            local mastery = getDoughMastery()

            if mastery then
                masteryLabel.Text = "🍩 Dough: " .. mastery .. " / " .. MASTERY_REQUIRED

                if mastery >= MASTERY_REQUIRED then
                    masteryLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                    statusLabel.Text = "✅ Đủ rồi! Đổi acc..."
                    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                    writefile(localPlayer.Name .. ".txt", "Completed-" .. localPlayer.Name .. ".json")
                    print("[Done] Đã ghi: " .. localPlayer.Name .. ".txt")
                    done = true
                else
                    local need = MASTERY_REQUIRED - mastery
                    masteryLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                    statusLabel.Text = "⏳ Cần thêm " .. need .. " Mas"
                    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                end
            else
                masteryLabel.Text = "🍩 Dough Mastery: N/A"
                masteryLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                statusLabel.Text = "❌ Chưa equip Dough"
                statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            end
        end)

        if not ok then warn("[Lỗi] " .. tostring(err)) end

        task.wait(5)
    until done

    print("[Script] Hoàn thành!")
end)
